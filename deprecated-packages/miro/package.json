{
  "name": "@dreki-gg/pi-miro",
  "version": "0.5.0",
  "description": "Create native Miro board items from pi — shapes, connectors, frames, and auto-laid-out diagrams",
  "keywords": [
    "pi-package",
    "pi",
    "miro",
    "diagram",
    "whiteboard",
    "dagre"
  ],
  "author": "Juan Albarran <jalbarrandev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreki-gg/pi-extensions",
    "directory": "packages/miro"
  },
  "type": "module",
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint extensions test",
    "format": "oxfmt --write extensions test",
    "format:check": "oxfmt --check extensions test"
  },
  "pi": {
    "extensions": [
      "./extensions/miro"
    ]
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@mirohq/miro-api": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "24",
    "bun-types": "^1.3.14",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
