{
  "name": "dreki-pi-extensions",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test test/*.test.ts",
    "lint": "bun run --filter '*' lint",
    "format": "bun run --filter '*' format",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-skill-versions.mjs",
    "publish": "changeset publish",
    "deploy:public": "./scripts/deploy-public.sh",
    "deploy:public:force": "./scripts/deploy-public.sh --force",
    "deploy:public:dry": "./scripts/deploy-public.sh --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@earendil-works/pi-agent-core": "^0.75.4",
    "@earendil-works/pi-ai": "^0.75.4",
    "@earendil-works/pi-coding-agent": "^0.75.4",
    "@earendil-works/pi-tui": "^0.75.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "typebox": "^1.0.55"
  }
}
