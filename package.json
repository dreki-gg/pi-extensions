{
  "name": "dreki-pi-extensions",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "pretypecheck": "bun run build",
    "typecheck": "bun run --filter '*' typecheck",
    "compat": "bun test test/pi-compat.test.ts",
    "test": "bun run compat && bun run --filter '@dreki-gg/pi-lsp' test && bun run --filter '@dreki-gg/pi-code-reviewer' test",
    "lint": "bun run --filter '*' lint",
    "format": "bun run --filter '*' format",
    "changeset": "changeset",
    "version": "changeset version",
    "build": "bun run --filter '@dreki-gg/pi-command-sandbox' build && bun run --filter '@dreki-gg/taskman' build",
    "publish": "bun run build && changeset publish",
    "deploy:local": "./scripts/deploy-local.sh",
    "deploy:local:force": "./scripts/deploy-local.sh --force",
    "deploy:local:dry": "./scripts/deploy-local.sh --dry-run",
    "registry:start": "pwsh -NoProfile -File ./scripts/local-registry.ps1 start",
    "registry:stop": "pwsh -NoProfile -File ./scripts/local-registry.ps1 stop",
    "registry:status": "pwsh -NoProfile -File ./scripts/local-registry.ps1 status",
    "registry:autostart": "pwsh -NoProfile -File ./scripts/local-registry.ps1 install-startup",
    "registry:autostart:remove": "pwsh -NoProfile -File ./scripts/local-registry.ps1 uninstall-startup",
    "deploy:local:win": "pwsh -NoProfile -File ./scripts/deploy-local.ps1",
    "deploy:local:win:force": "pwsh -NoProfile -File ./scripts/deploy-local.ps1 -Force",
    "deploy:local:win:dry": "pwsh -NoProfile -File ./scripts/deploy-local.ps1 -DryRun",
    "deploy:public": "./scripts/deploy-public.sh",
    "deploy:public:force": "./scripts/deploy-public.sh --force",
    "deploy:public:dry": "./scripts/deploy-public.sh --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@earendil-works/pi-agent-core": "^0.75.4",
    "@earendil-works/pi-ai": "^0.75.4",
    "@earendil-works/pi-coding-agent": "^0.75.4",
    "@earendil-works/pi-tui": "^0.75.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "typebox": "^1.0.55"
  }
}
