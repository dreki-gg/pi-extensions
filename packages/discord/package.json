{
  "name": "@dreki-gg/pi-discord",
  "version": "0.2.0",
  "description": "Discord read tools for pi — pull channel messages and attachments for agent context with an Effect-powered bot client",
  "keywords": [
    "pi-package",
    "pi",
    "discord",
    "messages",
    "context"
  ],
  "author": "Juan Albarran <jalbarrandev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreki-gg/pi-extensions",
    "directory": "packages/discord"
  },
  "type": "module",
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint extensions test",
    "format": "oxfmt --write extensions test",
    "format:check": "oxfmt --check extensions test"
  },
  "pi": {
    "extensions": [
      "./extensions/discord"
    ]
  },
  "dependencies": {
    "effect": "^3.16.0",
    "@effect/platform": "^0.78.0"
  },
  "devDependencies": {
    "@types/node": "24",
    "bun-types": "^1.3.14",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
