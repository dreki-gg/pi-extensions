{
  "name": "@dreki-gg/pi-stacked-prs",
  "version": "0.2.0",
  "description": "Stacked PR workflow for pi — skill + /stack commands wrapping the @kitlangton/stack CLI for squash-safe stacked pull/merge requests",
  "keywords": [
    "pi-package",
    "pi",
    "stacked-prs",
    "stacking",
    "github",
    "gitlab",
    "pull-request"
  ],
  "author": "Juan Albarran <jalbarrandev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreki-gg/pi-extensions",
    "directory": "packages/stacked-prs"
  },
  "type": "module",
  "files": [
    "extensions",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint extensions",
    "format": "oxfmt --write extensions",
    "format:check": "oxfmt --check extensions"
  },
  "pi": {
    "extensions": [
      "./extensions/stacked-prs"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@types/node": "24",
    "bun-types": "^1.3.14",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  }
}
